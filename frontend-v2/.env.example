# Frontend environment variables (VITE_ prefixed, baked at build time)
# These are typically passed as build args in docker compose.

VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=
# Temporary safety freeze; keep false until the deep-research rewrite passes its release gates.
VITE_DEEP_RESEARCH_MUTATIONS_ENABLED=false
